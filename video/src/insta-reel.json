   "role": "Moderator, Panel Discussion",
   "alum": true,
   "caps": [
    {
     "t0": 0.35,
     "t1": 3.9,
     "text": "Imagine if a student gets up and asks:"
    },
    {
     "t0": 3.9,
     "t1": 5.55,
     "text": "do we know what we are actually throwing away?"
    },
    {
     "t0": 5.55,
     "t1": 7.7,
     "text": "Precisely these were the questions"
    },
    {
     "t0": 7.7,
     "t1": 11.05,
     "text": "that NBN Sir taught us to ask,"
    },
    {
     "t0": 11.05,
     "t1": 13.1,
     "text": "not just in class, in our lives too."
    }
   ],
   "from": 412
