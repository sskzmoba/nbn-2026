   "texts": [
    {
     "t0": 0.0,
     "label": "Fireside Chat",
     "title": "The Teachers and Experiences That Shape Us",
     "t1": 6.4
    }
   ],
   "from": 3696
  },
  {
   "kind": "clip",
   "dur": 17.15,
   "src": "film/amala.mp4",
   "name": "Smt Amala Akkineni",
   "role": "Director, Annapurna College of Film and Media",
   "alum": false,
   "caps": [
    {
     "t0": 0.45,
     "t1": 4.25,
     "text": "If you are going back with a gift from me,"
    },
    {
     "t0": 4.25,
     "t1": 6.05,
     "text": "carry the word mindset."
    },
    {
     "t0": 5.5,
     "t1": 11.2,
     "text": "…see how your assessments can open up to new ways"
    },
    {
     "t0": 11.2,
     "t1": 17.0,
     "text": "where the child then becomes a learner for life."
    }
   ],
   "from": 3888
  },
  {
   "kind": "inter",
   "dur": 4.2,
   "photos": [
    {
     "at": 0.0,
     "dur": 4.2,
