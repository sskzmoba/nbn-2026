   ],
   "texts": [
    {
     "t0": 0.0,
     "label": "Special Address",
     "title": "Inspiring the Next Generation to Serve",
     "t1": 4.2
    }
   ],
   "from": 4402
  },
  {
   "kind": "clip",
   "dur": 14.15,
   "src": "film/gurung.mp4",
   "name": "Col Sidharth Karanbir Gurung",
   "role": "Deputy Commander, 91 Infantry Brigade",
   "alum": false,
   "caps": [
    {
     "t0": 0.35,
     "t1": 2.95,
     "text": "To guide young minds, you are often"
    },
    {
     "t0": 2.95,
     "t1": 5.75,
     "text": "the first to notice a spark in a child."
    },
    {
     "t0": 5.4,
     "t1": 8.2,
     "text": "Teachers light the way."
    },
    {
     "t0": 8.2,
     "t1": 10.1,
     "text": "I ask you to keep lighting it,"
    },
    {
     "t0": 10.1,
     "t1": 14.0,
     "text": "and now and then to point it towards the defence forces."
    }
   ],
   "from": 4528
  },
  {
   "kind": "inter",
   "dur": 6.4,
   "photos": [
    {
