   ],
   "texts": [
    {
     "t0": 0.0,
     "label": "Keynote",
     "title": "Leading Schools That Shape Generations",
     "t1": 6.4
    }
   ],
   "from": 4953
  },
  {
   "kind": "clip",
   "dur": 20.42,
   "src": "film/ashok.mp4",
   "name": "Dr B Ashok IAS",
   "role": "Chief Guest · Principal Secretary, Higher Education, Government of Keralam",
   "alum": false,
   "caps": [
    {
     "t0": 0.37,
     "t1": 4.57,
     "text": "Learning is inherently a very pleasurable thing."
    },
    {
     "t0": 4.57,
     "t1": 7.37,
     "text": "There is a lot of pleasure involved in knowing new things"
    },
    {
     "t0": 7.37,
     "t1": 8.97,
     "text": "just for the sake of it,"
    },
    {
     "t0": 8.97,
     "t1": 12.37,
     "text": "for exploring a thing, researching a thing,"
    },
    {
     "t0": 12.37,
     "t1": 17.67,
     "text": "delving deep into the facts…"
    },
    {
     "t0": 17.67,
     "t1": 20.27,
     "text": "and then discovering things afresh."
    }
   ],
   "from": 5145
  },
